# Plantilla de credenciales. Copiá este archivo a `.env` y completá tus datos:
#     cp .env.example .env
# El `.env` está gitignored: NUNCA se commitea. Cada cliente usa sus propias credenciales.
# Alternativa: exportar estas variables en el entorno (tienen precedencia sobre el .env),
# o pasarlas por flag (--pod/--user/--password). Las lee qualys_client.from_env().
#
# IMPORTANTE: usá un API user de SOLO LECTURA. La herramienta es read-only, pero igual
# conviene mínimo privilegio. El password jamás se loguea.

# POD / plataforma de tu suscripción Qualys. Conocidos: US01 US02 US03 US04 EU01 EU02
# EU03 IN01 CA01 AE01 UK01 AU01. Verificá el tuyo en la consola si no está en la lista.
QUALYS_POD=US03

# Credenciales del API user (SOLO LECTURA).
QUALYS_API_USER=
QUALYS_API_PASSWORD=

# --- Opcional: parámetros del orquestador (run.sh / run.ps1) ---
# Precedencia: variable de entorno > este .env > default. Comentarios en su propia línea (no inline).

# Tope de hosts a barrer en el motor PC (Policy Compliance). Subilo para flotas grandes.
MAX_HOSTS=300

# Título de la policy generada (opcional; default: "Ley 21.719 - Medidas de Seguridad").
# PACK_NAME=Ley 21.719 - Mi Empresa
